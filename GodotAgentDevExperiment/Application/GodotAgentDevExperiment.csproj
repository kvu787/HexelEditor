<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GodotAgentDevExperiment</RootNamespace>
    <!-- Godot loads the assembly dynamically, so its dependencies have to be copied next to it. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Keeps the compiler server from holding files open after a command line build. -->
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Experiment.Core.csproj" />
  </ItemGroup>
</Project>
