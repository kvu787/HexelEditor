<Window x:Class="HexelEditor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HexelEditor.Desktop"
        Title="Hexel Editor" Width="1440" Height="960" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen" Closing="OnClosing" PreviewKeyDown="OnKeyDown" PreviewKeyUp="OnKeyUp">
  <Grid Background="{StaticResource SurfaceAlternate}">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <!-- Menu bar -->
    <Border Grid.Row="0" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0">
        <Path DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0" Width="18" Height="19"
              Stretch="Uniform" Fill="{StaticResource Muted}"
              Data="M 14,0 L 27,7 L 27,22 L 14,29 L 1,22 L 1,7 Z M 14,7 L 20,11 L 20,18 L 14,22 L 8,18 L 8,11 Z" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Save" Click="SaveClicked" Margin="0,0,8,0" />
          <Button Content="Export PNG" Click="ExportPngClicked" Style="{StaticResource AccentButton}" />
        </StackPanel>
        <Menu VerticalAlignment="Center">
          <MenuItem x:Name="FileMenu" Header="_File">
            <MenuItem Header="New canvas..." InputGestureText="Ctrl+N" Click="NewProjectClicked" />
            <MenuItem Header="Open project..." InputGestureText="Ctrl+O" Click="OpenClicked" />
            <MenuItem Header="Open example scene" Click="OpenExampleClicked" />
            <Separator />
            <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="SaveClicked" />
            <MenuItem Header="Save as..." InputGestureText="Ctrl+Shift+S" Click="SaveAsClicked" />
            <Separator />
            <MenuItem Header="Export PNG..." Click="ExportPngClicked" />
            <MenuItem Header="Export SVG..." Click="ExportSvgClicked" />
            <Separator />
            <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="ExitClicked" />
          </MenuItem>
          <MenuItem Header="_Edit">
            <MenuItem x:Name="UndoMenuItem" Header="Undo" InputGestureText="Ctrl+Z" Click="UndoClicked" />
            <MenuItem x:Name="RedoMenuItem" Header="Redo" InputGestureText="Ctrl+Y" Click="RedoClicked" />
            <Separator />
            <MenuItem Header="Copy cells" InputGestureText="Ctrl+C" Click="CopyClicked" />
            <MenuItem x:Name="CutMenuItem" Header="Cut cells" InputGestureText="Ctrl+X" Click="CutClicked" />
            <MenuItem x:Name="PasteMenuItem" Header="Paste at cursor" InputGestureText="Ctrl+V" Click="PasteClicked" />
            <Separator />
            <MenuItem x:Name="RotateClockwiseMenuItem" Header="Rotate selection clockwise 60 degrees"
                      InputGestureText="Ctrl+R" Click="RotateClockwiseClicked" />
            <MenuItem x:Name="RotateCounterclockwiseMenuItem" Header="Rotate selection counterclockwise 60 degrees"
                      InputGestureText="Ctrl+Shift+R" Click="RotateCounterclockwiseClicked" />
            <Separator />
            <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="SelectAllClicked" />
            <MenuItem Header="Deselect" InputGestureText="Esc" Click="DeselectClicked" />
            <MenuItem x:Name="ClearMenuItem" Header="Clear cells" InputGestureText="Delete" Click="ClearClicked" />
          </MenuItem>
          <MenuItem Header="_View">
            <MenuItem Header="Fit canvas" InputGestureText="F" Click="FitClicked" />
            <MenuItem Header="Zoom in" InputGestureText="+" Click="ZoomInClicked" />
            <MenuItem Header="Zoom out" InputGestureText="-" Click="ZoomOutClicked" />
            <Separator />
            <MenuItem x:Name="GridMenuItem" Header="Hide grid" InputGestureText="H" Click="ToggleGridClicked" />
          </MenuItem>
          <MenuItem Header="_Help">
            <MenuItem Header="Shortcuts" Click="HelpClicked" />
          </MenuItem>
        </Menu>
      </DockPanel>
    </Border>

    <!-- Command toolbar -->
    <Border Grid.Row="1" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="ShowGrid" Content="Grid" Checked="GridChanged" Unchecked="GridChanged"
                    Margin="0,0,14,0" ToolTip="Show the hexagon grid (H)" />
          <Border Width="1" Background="{StaticResource Divider}" Margin="0,10,10,10" />
          <Button Content="-" Click="ZoomOutClicked" Style="{StaticResource ToolbarButton}" Padding="10,4"
                  ToolTip="Zoom out" />
          <TextBlock x:Name="ZoomLabel" Text="100%" Width="54" TextAlignment="Center" VerticalAlignment="Center" />
          <Button Content="+" Click="ZoomInClicked" Style="{StaticResource ToolbarButton}" Padding="10,4"
                  ToolTip="Zoom in" />
          <Button Content="Fit" Click="FitClicked" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0"
                  ToolTip="Fit the canvas in the view (F)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="UndoButton" Content="Undo" Click="UndoClicked" Style="{StaticResource ToolbarButton}" />
          <Button x:Name="RedoButton" Content="Redo" Click="RedoClicked" Style="{StaticResource ToolbarButton}" />
          <Border Width="1" Background="{StaticResource Divider}" Margin="10,10,12,10" />
          <TextBlock Text="Brush" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
          <Button Content="-" Click="SmallerBrushClicked" Style="{StaticResource ToolbarButton}" Padding="10,4"
                  ToolTip="Smaller brush ([)" />
          <TextBlock x:Name="BrushSizeLabel" Text="1" Width="34" TextAlignment="Center" VerticalAlignment="Center" />
          <Button Content="+" Click="LargerBrushClicked" Style="{StaticResource ToolbarButton}" Padding="10,4"
                  ToolTip="Larger brush (])" />
          <CheckBox x:Name="FilledShapes" Content="Filled shapes" Margin="18,0,0,0"
                    ToolTip="Fill rectangles instead of drawing only their outline" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Tool rail, editor, and side bar -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="54" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="310" />
      </Grid.ColumnDefinitions>

      <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0">
        <StackPanel x:Name="ToolsPanel" Margin="0,8,0,0" />
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="36" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Document tab -->
        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Grid DockPanel.Dock="Left">
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0" />
              <Border Height="2" VerticalAlignment="Top" Background="{StaticResource Accent}" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,18,0">
                <Ellipse x:Name="UnsavedMarker" Width="8" Height="8" Fill="{StaticResource Muted}" Margin="0,0,9,0"
                         VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Unsaved changes" />
                <TextBlock x:Name="DocumentTitle" Text="Neon tide" VerticalAlignment="Center"
                           Foreground="{StaticResource StrongInk}" />
              </StackPanel>
            </Grid>
            <TextBlock x:Name="DocumentDetails" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>

        <local:HexCanvas x:Name="EditorCanvas" Grid.Row="1" Focusable="True" ClipToBounds="True" />
      </Grid>

      <!-- Side bar -->
      <Border Grid.Column="2" BorderBrush="{StaticResource Divider}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Expander Header="Color" Style="{StaticResource Section}">
              <StackPanel>
                <Grid Margin="0,4,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="CurrentColorPreview" Height="46" CornerRadius="4" BorderThickness="1"
                          BorderBrush="{StaticResource Outline}" />
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Foreground" Style="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="CurrentColorLabel" FontFamily="Consolas" FontSize="16" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Set" Click="SetColorClicked" Margin="8,0,0,0" />
                  <TextBox x:Name="ColorInput" Text="#000000" MaxLength="9" KeyDown="ColorInputKeyDown"
                           ToolTip="#RRGGBB or #AARRGGBB" />
                </DockPanel>
              </StackPanel>
            </Expander>

            <Expander Header="Palette" Style="{StaticResource Section}">
              <StackPanel>
                <WrapPanel x:Name="PalettePanel" Margin="0,4,0,0" />
                <Button Content="Add current color" Click="AddColorClicked" HorizontalAlignment="Left" Margin="0,8,0,0" />
              </StackPanel>
            </Expander>

            <Expander Header="Layers" Style="{StaticResource Section}">
              <StackPanel>
                <StackPanel x:Name="LayersPanel" Margin="0,4,0,0" />
                <WrapPanel Margin="0,8,0,14">
                  <Button Content="Add" Click="AddLayerClicked" Style="{StaticResource ToolbarButton}" Margin="0,0,2,0" />
                  <Button x:Name="DeleteLayerButton" Content="Delete" Click="DeleteLayerClicked"
                          Style="{StaticResource ToolbarButton}" Margin="0,0,2,0" />
                  <Button Content="Up" Click="LayerUpClicked" Style="{StaticResource ToolbarButton}" Margin="0,0,2,0" />
                  <Button Content="Down" Click="LayerDownClicked" Style="{StaticResource ToolbarButton}" Margin="0,0,2,0" />
                  <Button Content="Rename" Click="RenameLayerClicked" Style="{StaticResource ToolbarButton}" />
                </WrapPanel>
                <DockPanel Margin="0,0,0,2">
                  <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" />
                  <TextBlock Text="Opacity" Style="{StaticResource SecondaryText}" />
                </DockPanel>
                <Slider x:Name="LayerOpacity" Minimum="0" Maximum="255" Value="255" SmallChange="1" LargeChange="16"
                        IsMoveToPointEnabled="True" PreviewMouseLeftButtonUp="OpacityReleased"
                        LostKeyboardFocus="OpacityKeyboardFinished" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0">
      <DockPanel Margin="16,0">
        <TextBlock x:Name="SelectionStatus" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13"
                   Foreground="{StaticResource Muted}" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="ToolLabel" Text="Pencil" FontSize="13" />
          <TextBlock x:Name="StatusLabel" FontSize="13" Foreground="{StaticResource Muted}" Margin="18,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
